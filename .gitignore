# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/

# OS
.DS_Store

# Editors / tooling
.vscode/
.idea/
.claude/settings.local.json

# Raw/cached source data -- not distributed with this repository, see
# docs/data_card.md. Only the README.md placeholders in these folders are
# tracked; the real data they describe is not. (Patterns cover every file
# type a user is likely to drop in, not just the one we happened to ship.)
data/raw/pjm_load/*
!data/raw/pjm_load/README.md
data/raw/wind/*
!data/raw/wind/README.md
data/cache/pjm_load/*
!data/cache/pjm_load/README.md
data/cache/wind/*
!data/cache/wind/README.md

# Real PJM data, however processed. `enerdatasynth preprocess` builds these from
# your own copy of the source files; only metadata.json (the scalers the shipped
# checkpoint needs) and the README are tracked.
data/processed/pjm_load/*
!data/processed/pjm_load/README.md
!data/processed/pjm_load/metadata.json
data/processed/pjm_load_backup/
data/research_history/**/*.npy
data/research_history/**/*.parquet

# LaTeX build artifacts (paper/)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
